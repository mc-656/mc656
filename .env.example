# Configurações do Banco de Dados
DB_USERNAME=
DB_PASSWORD=
DB_NAME=eleicao
DB_PORT=5433
HMAC=   # echo -n "alguma palavra" | sha512sum
COMPROVANTE_CHAVE=   # openssl rand -base64 32 (chave AES-256 do comprovante de voto, RNF-01)
# Observabilidade (RNF-06)
METRICAS_EMAILS=  # e-mails (vírgula) das contas que leem /actuator/prometheus; vazio nega a todos
# SPRING_PROFILES_ACTIVE=log-json  # logs em JSON (ECS) com correlationId; deixe comentado no dev local

# SMTP do envio de convites (RF-17)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@eleicao.local
APP_URL_BASE=http://localhost:8080  # base dos links de convite
