# Configurações do Banco de Dados
DB_USERNAME=
DB_PASSWORD=
DB_NAME=eleicao
DB_PORT=5433
HMAC=   # echo -n "alguma palavra" | sha512sum
COMPROVANTE_CHAVE=   # openssl rand -base64 32 (chave AES-256 do comprovante de voto, RNF-01)
# SMTP do envio de convites (RF-17). Padrão: Mailpit local do compose (UI em http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=nao-responda@eleicao.local
APP_URL_BASE=http://localhost:8080   # base dos links de convite
