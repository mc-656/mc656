# Copiar para .env na VPS (mesma pasta do compose.yaml) e preencher. Nunca versionar o .env.

# Domínio apontando para a VPS. nip.io resolve <qualquer-coisa>.<ip>.nip.io para <ip>,
# sem precisar registrar domínio (ex.: VPS em 203.0.113.10)
DOMINIO=eleicao.203.0.113.10.nip.io
# Base dos links de convite (RF-17)
APP_URL_BASE=https://eleicao.203.0.113.10.nip.io

DB_USERNAME=eleicao
# openssl rand -hex 24
DB_PASSWORD=
DB_NAME=eleicao
# openssl rand -hex 64
HMAC=
# openssl rand -base64 32
COMPROVANTE_CHAVE=

METRICAS_EMAILS=
SPRING_PROFILES_ACTIVE=log-json

# SMTP real para convites (RF-17); ex.: Brevo, ou Gmail com senha de app
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Opcional: limite de heap da JVM (padrão -XX:MaxRAMPercentage=75)
# JAVA_OPTS=-XX:MaxRAMPercentage=60

# Gerenciado pelo deploy.sh: imagem em execução
IMAGEM=ghcr.io/mc-656/mc656:latest
